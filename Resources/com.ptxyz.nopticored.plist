<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Device target: iPhone 7 Plus (iPhone9,4), iOS 15.8.7, jailbreak ROOTLESS
     (Audit 13.1) -- semua path di bawah pakai prefix /var/jb. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ptxyz.nopticored</string>
	<key>Program</key>
	<string>/var/jb/usr/libexec/nopticored</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/libexec/nopticored</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/jb/var/log/nopticored.log</string>
	<key>StandardErrorPath</key>
	<string>/var/jb/var/log/nopticored.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
